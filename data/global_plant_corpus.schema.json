{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Plant Corpus Record",
  "type": "object",
  "required": [
    "record_id",
    "canonical_scientific_name",
    "taxonomic_status",
    "family",
    "provenance",
    "feed_review_status"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_scientific_name": {
      "type": "string",
      "minLength": 1
    },
    "authorship": {
      "type": [
        "string",
        "null"
      ]
    },
    "taxonomic_status": {
      "enum": [
        "accepted",
        "synonym",
        "unplaced",
        "unresolved"
      ]
    },
    "accepted_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "genus": {
      "type": [
        "string",
        "null"
      ]
    },
    "rank": {
      "type": [
        "string",
        "null"
      ]
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "common_names": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language",
          "name"
        ],
        "properties": {
          "language": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "native_range": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "introduced_range": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "korea_status": {
      "enum": [
        "native",
        "naturalized",
        "cultivated",
        "imported",
        "specialty_only",
        "not_confirmed"
      ]
    },
    "feed_review_status": {
      "enum": [
        "identity_only",
        "evidence_found",
        "assessed",
        "unresolved"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_name",
          "source_url",
          "observed_at"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_name": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "source_record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": "string"
          }
        }
      }
    },
    "feed_assessment": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "feed_review_status": {
            "const": "identity_only"
          }
        }
      },
      "then": {
        "properties": {
          "feed_assessment": {
            "type": "null"
          }
        }
      }
    }
  ]
}
